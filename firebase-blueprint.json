{
  "entities": {
    "User": {
      "title": "User",
      "description": "Barangay portal user account with RBAC and security state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["resident", "staff", "captain", "admin", "official"] },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "suspended"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "email", "fullName", "role", "status"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Resident personal census and official identification details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "purokZone": { "type": "string" },
        "contactNumber": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "firstName", "lastName"]
    },
    "ClearanceRequest": {
      "title": "ClearanceRequest",
      "description": "Barangay document clearance or certificate request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "residentId": { "type": "string" },
        "residentName": { "type": "string" },
        "type": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "released"] },
        "urgency": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "residentId", "residentName", "type", "purpose", "status"]
    },
    "MfaDispatch": {
      "title": "MfaDispatch",
      "description": "Two-factor authentication passcode dispatch and delivery event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "otpCode": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "otpCode", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Cryptographically chained immutable audit log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "details": { "type": "string" },
        "hash": { "type": "string" },
        "prevHash": { "type": "string" }
      },
      "required": ["id", "timestamp", "actorName", "action", "entity", "hash"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification alert message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts and role metadata"
    },
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Resident personal census and official identification details"
    },
    "/clearanceRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ClearanceRequest" },
      "description": "Clearance requests with status workflow"
    },
    "/mfaDispatches/{dispatchId}": {
      "schema": { "$ref": "#/entities/MfaDispatch" },
      "description": "Two-factor security code dispatches"
    },
    "/auditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Live immutable security audit logs"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time user alerts and notification inbox"
    }
  }
}
